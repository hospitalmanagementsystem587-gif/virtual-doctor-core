# Environment Configuration for Virtual Doctor Core

APP_NAME="Virtual Doctor Copilot"
APP_ENV="development"
DEBUG=true
PORT=8010
HOST="0.0.0.0"

# CORS Origins (allow parent hospital domains and local testing)
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:8000","http://localhost:8010"]

# AI Model Provider: "gemini" | "ollama" | "local" | "mock"
LLM_PROVIDER="gemini"
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-2.5-flash"

# Vector Knowledge Base (rebuild index after changing: python -m app.rag.embedding_index)
EMBEDDING_MODEL_NAME="gemini-embedding-001"
EMBEDDING_DIMENSIONS=768

# Hospital Integration Webhook (Optional - pushes generated SOAP note directly to HMS)
HMS_API_URL="http://127.0.0.1:8000/api/v1/opd-intake/"
HMS_API_KEY=""
